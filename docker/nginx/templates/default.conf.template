server {
    listen 80 default_server;
    server_tokens off;

    # Common proxy headers
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;

    # ---------------------------------------------------------------------
    # Sub-app backends — add /api/<name>/ blocks here when a sub-app gains
    # its own backend service. Longer prefixes win under nginx longest-match.
    # ---------------------------------------------------------------------

    # Shell API — all /api/* not claimed by a sub-app above.
    location /api/ {
        proxy_pass http://${SHELL_API_HOST};
    }

    # Sub-app SPAs
    location /apps/access-manager/ {
        proxy_pass http://${ACCESS_MANAGER_HOST};
    }

    # Shell SPA — everything else, including /auth-client-redirect.
    location / {
        proxy_pass http://${SHELL_HOST};
    }
}
