{
  "name": "apps-template",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean && rm -rf node_modules .turbo"
  },
  "devDependencies": {
    "turbo": "^2.9.14",
    "typescript": "^5.9.3",
    "prettier": "^3.4.2",
    "eslint": "^9.39.4",
    "@eslint/js": "^9.39.4",
    "@eslint/eslintrc": "^3.3.5"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "packageManager": "npm@11.12.1"
}
