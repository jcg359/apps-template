# Microsoft Entra ID app registration (shared with the shell — SPA platform)
VITE_AUTH_CLIENT_ID=
VITE_AUTH_TENANT_ID=

# Redirect URI is always the shell's /auth-client-redirect
# VITE_AUTH_REDIRECT_URI=https://shell.example.com/auth-client-redirect

# Scope used when calling APIs
VITE_AUTH_API_SCOPE=User.Read

# Set to 1 to bypass MSAL entirely (standalone dev only)
# VITE_MOCK_USER=1
