# Public base URL of the shell app — used for absolute links and callback URLs.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Secret used to sign/encrypt NextAuth session JWTs and the session cookie.
# Generate with: openssl rand -base64 32
# AUTH_SECRET=

# Microsoft Entra ID (Azure AD) app registration values.
# AUTH_MICROSOFT_ENTRA_ID_ID     — Application (client) ID from the Entra app registration
# AUTH_MICROSOFT_ENTRA_ID_SECRET — Client secret value from "Certificates & secrets"
# AUTH_MICROSOFT_ENTRA_ID_ISSUER — https://login.microsoftonline.com/<tenant-id>/v2.0
#                                  (for multi-tenant apps use the "common" or "organizations" endpoint)
AUTH_MICROSOFT_ENTRA_ID_ID=
AUTH_MICROSOFT_ENTRA_ID_SECRET=
AUTH_MICROSOFT_ENTRA_ID_ISSUER=

# Needed when a shared session store is added (e.g. for cross-sub-app session sharing).
REDIS_URL=

# Dev convenience: SKIP_AUTH=1 bypasses the proxy so the UI loads without Entra
# credentials. Hard-gated to non-production — ignored when NODE_ENV=production.
# SKIP_AUTH=

SKIP_AUTH=1
AUTH_SECRET=dev-only