# Microsoft Entra ID app registration (SPA platform)
VITE_AUTH_CLIENT_ID=
VITE_AUTH_TENANT_ID=

# Optional: defaults to ${origin}/auth-client-redirect
# VITE_AUTH_REDIRECT_URI=

# Scope used when acquiring tokens for shell-api / Microsoft Graph
# Examples: User.Read | api://<shell-api-client-id>/Apps.Read
VITE_AUTH_API_SCOPE=User.Read

# Set to 1 to bypass MSAL entirely (standalone dev only)
# VITE_MOCK_USER=1
